{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stash",
  "version": "0.1.2",
  "identifier": "com.stash.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Stash",
        "width": 1080,
        "height": 720,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 },
        "visible": false
      },
      {
        "label": "palette",
        "title": "",
        "url": "/",
        "width": 640,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' https://raw.githubusercontent.com https://eu.i.posthog.com https://eu-assets.i.posthog.com"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0NzI1NURGNjZCNkIxNUMKUldSY3NiWm0zMVZ5dEx2L2N3ZEhiT1RPNWxqNE5Ydm5DSDhXODRpTFBIT3VQOFlzRkJuMUsvd3QK",
      "endpoints": [
        "https://github.com/Rosqueta/stash/releases/latest/download/latest.json"
      ]
    }
  }
}
